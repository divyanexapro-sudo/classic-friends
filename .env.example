# Copy to .env (or set in your host's dashboard). Then:  npm start
PORT=3000
ADMIN_TOKEN=classicfriends-admin        # change this before going live (in production: 16+ chars, the default is refused)
BOTS=70                        # simulated people keeping rooms alive (0 = none)
START_COINS=1000               # welcome coins for a new account

# NODE_ENV=production          # locks the admin API until ADMIN_TOKEN is set, turns off free coin packs
# DATA_FILE=server/data/users.json   # where real users are saved (every 30 s and on shutdown)
# FREE_RECHARGE=1              # credit coin packs without payment. Default: on in development, off in production.
#                              # Leave off in production until a payment gateway webhook calls engine.recharge.

# Voice (WebRTC). STUN alone fails for many users on mobile data / strict networks — add a TURN server for production.
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=
